{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinguaDock",
  "version": "1.0.1",
  "identifier": "io.github.pascalepaf.linguadock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LinguaDock",
        "width": 560,
        "height": 315,
        "minWidth": 480,
        "minHeight": 270,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "publisher": "PascalePaF",
    "category": "Productivity",
    "shortDescription": "自适应四语 Google 翻译桌面小窗",
    "longDescription": "可置顶或通过全局快捷键唤出的极简翻译小窗，在简体中文、英语、日语和繁体中文之间生成四语对照，并提供单词多义项与用法。",
    "copyright": "Copyright © 2026 PascalePaF",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "TradChinese", "English", "Japanese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCMzE2NTI3QUYyQkZFRkMKUldUOC9pdXZKMlV4VzRzSmRyNG1YZnBycFQ3c0czTjRpR2dTSE9LUERUclhmRXZJWTg3OWNhbnoK",
      "endpoints": [
        "https://github.com/PascalePaF/LinguaDock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
